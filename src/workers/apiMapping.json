    { "domain": "GrosFichiers", "action": "supprimerVideo" },
    { "domain": "GrosFichiers", "action": "recycleItemsV3" },
    { "domain": "GrosFichiers", "action": "updateFileTextContent" },
    { "domain": "GrosFichiers", "action": "deleteFileComment" },
